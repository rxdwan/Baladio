{
  "name": "Baladio",
  "version": "3.1.0",
  "description": "Baladio",
  "license": "GPL-3.0",
  "author": {
    "name": "rxdwan",
    "email": "rxdwan@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rxdwan/baladio.git"
  },
  "homepage": "https://rxdwan.github.io/baladio-product-page",
  "main": "electron-main.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "electron:build": "electron-builder",
    "electron:build:win": "electron-builder --win",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:linux": "electron-builder --linux",
    "electron:build:all": "electron-builder -wlm"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "jintr": "^3.3.1",
    "lamejs": "^1.2.1",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^7.14.0",
    "node-id3": "^0.2.6"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rxdwan.baladio",
    "productName": "Baladio",
    "copyright": "Copyright © 2026 rxdwan",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "splash.html",
      "splash-preload.js",
      "server.js",
      "LICENSE",
      "CHANGELOG.md",
      "public/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/electron-builder/**/*",
      "!.installer/**/*",
      "!.mobile/**/*",
      "!dist/**/*",
      "!dist-electron/**/*"
    ],
    "asarUnpack": [
      "public/assets/default_song_cover.jpg",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/assets/logo.ico",
      "executableName": "baladio",
      "requestedExecutionLevel": "asInvoker",
      "publisherName": "rxdwan",
      "legalTrademarks": "Baladio",
      "artifactName": "Baladio-win-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/assets/logo.icns",
      "category": "public.app-category.music",
      "artifactName": "Baladio-mac-${version}.${ext}"
    },
    "linux": {
      "target": [
        "deb"
      ],
      "icon": "public/assets/logo.png",
      "category": "Audio",
      "artifactName": "Baladio-linux-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/assets/logo.ico",
      "uninstallerIcon": "public/assets/logo.ico",
      "installerHeaderIcon": "public/assets/logo.ico",
      "shortcutName": "Baladio",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Baladio-win-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "mp3",
        "name": "MP3 Audio",
        "role": "Viewer"
      },
      {
        "ext": "flac",
        "name": "FLAC Audio",
        "role": "Viewer"
      },
      {
        "ext": "wav",
        "name": "WAV Audio",
        "role": "Viewer"
      }
    ]
  }
}
